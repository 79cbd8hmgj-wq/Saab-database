  "issues": [
    {
      "id": "sel-issue-001",
      "title": "AS-PL Saab 9-3 B207 and 9-5 B235 alternator catalogue products are not interchangeable",
      "applicability": {
        "groups": [
          {
            "platforms": [
              "9-3-9440"
            ],
            "model_years": [
              2005,
              2006
            ],
            "markets": [
              "US",
              "CA"
            ],
            "engine_codes": [
              "B207R"
            ]
          },
          {
            "platforms": [
              "9-5-9600"
            ],
            "model_years": [
              2006,
              2007,
              2008,
              2009
            ],
            "markets": [
              "US",
              "CA"
            ],
            "engine_codes": [
              "B235R"
            ]
          }
        ]
      },
      "cause": "A0047 is 120A with 5-groove pulley and PL_2200 connector, while A0319 is 130A with 6-groove pulley and PL_9105.",
      "symptoms": [
        "Seller advertises unspecified Saab turbo alternator",
        "An alternator is offered based solely on amperage without verifying pulley or plug"
      ],
      "diagnosis_summary": "Check Saab original VIN, installed unit, output, pulley, mount and connector.",
      "correction_summary": "Use only vehicle-verified exact suitable replacement; do not swap A0047 for A0319 or vice versa from nameplate alone.",
      "source_ids": [
        "sel-src-001",
        "sel-src-005"
      ],
      "evidence_status": "documented",
      "limits": [
        "No actual electrical donor parts installed or tested",
        "AS-PL catalogue is not original Saab manufacturer OEM supersession"
      ]
    }
  ],
