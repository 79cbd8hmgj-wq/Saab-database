  "issues": [
    {
      "id": "pcv-supply-issue-001",
      "title": "Early 9-3 9400 B205/B235 oil leakage with potentially insufficient PCV flow",
      "applicability": {
        "platforms": [
          "9-3-9400"
        ],
        "model_years": [
          1999,
          2000,
          2001,
          2002,
          2003
        ],
        "engine_codes": [
          "B205",
          "B235"
        ]
      },
      "cause": "Factory bulletin reports crankcase ventilation may be inadequate under some operating conditions.",
      "symptoms": [
        "Oil leakage from engine, particularly timing-cover/block/head interface",
        "Potential crankshaft-seal oil leakage"
      ],
      "diagnosis_summary": "Factory bulletin conditionally checks ventilation and check valve 30 14 883 before escalating to resealing; use the full original bulletin and only safe supported access.",
      "correction_summary": "Complaint-conditioned factory renovation kit 55 561 200; replace degraded ancillary hoses or check valve when needed; investigate leaks persisting afterwards.",
      "source_ids": [
        "pcv-supply-src-001"
      ],
      "evidence_status": "documented",
      "review_status": "source_scoped",
      "limits": [
        "Not all affected production-year vehicles have the fault",
        "No claim a new kit reverses bearing damage or oil sludge",
        "No operating or running-engine test of a seized, uninspected or oil-starved nonrunner"
      ]
    }
  ],
